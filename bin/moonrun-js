#!/usr/bin/env node
// In the repository the TypeScript sources run directly, so a stale dist/ is never used.
// The published package ships dist/ only.
import { existsSync } from 'node:fs';

const src = new URL('../src/hosts/node/cli.ts', import.meta.url);
await import(existsSync(src) ? src.href : new URL('../dist/hosts/node/cli.js', import.meta.url).href);
