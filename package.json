{
  "name": "moonrun-js",
  "version": "0.1.1",
  "description": "A TypeScript implementation of MoonBit's moonrun for JavaScript runtimes",
  "keywords": [
    "moonbit",
    "moonrun",
    "wasm",
    "webassembly",
    "wasi",
    "jspi"
  ],
  "author": "Gakuto Furuya <g.furuya@gaato.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaato/moonrun-js.git"
  },
  "homepage": "https://github.com/gaato/moonrun-js#readme",
  "bugs": "https://github.com/gaato/moonrun-js/issues",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4",
  "bin": {
    "moonrun-js": "./bin/moonrun-js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/hosts/node/index.js",
    "./browser": "./dist/browser/index.js"
  },
  "files": [
    "dist",
    "bin/moonrun-js",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/check-browser-build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && oxlint --type-aware --deny-warnings src scripts test examples/browser && node scripts/check-layers.ts",
    "format": "biome format --write .",
    "test": "vitest run",
    "gen": "node scripts/gen-imports.ts",
    "demo:browser": "pnpm build && node scripts/browser-demo.ts",
    "build:tls": "node scripts/build-tls.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "@types/ws": "8.18.2",
    "fast-check": "4.10.2",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0"
  }
}
