;; Imports called from the start function run before memory is bound: every
;; memory-using function returns FAULT (21) before any other check; fd_close does not need memory.
(module
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $fd_read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close" (func $fd_close (param i32) (result i32)))
  (import "wasi_snapshot_preview1" "args_sizes_get" (func $args_sizes_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "random_get" (func $random_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_prestat_get" (func $fd_prestat_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_open" (func $path_open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (global $r1 (mut i32) (i32.const -1))
  (global $r2 (mut i32) (i32.const -1))
  (global $r3 (mut i32) (i32.const -1))
  (global $r4 (mut i32) (i32.const -1))
  (global $r5 (mut i32) (i32.const -1))
  (global $r6 (mut i32) (i32.const -1))
  (global $r7 (mut i32) (i32.const -1))
  (global $r8 (mut i32) (i32.const -1))

  (func $write (param $ptr i32) (param $len i32)
    (i32.store (i32.const 0) (local.get $ptr))
    (i32.store (i32.const 4) (local.get $len))
    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))
  (func $num (param $n i32)
    (local $p i32) (local $u i32) (local $neg i32)
    (i32.store8 (i32.const 47) (i32.const 10))
    (local.set $p (i32.const 47))
    (local.set $neg (i32.lt_s (local.get $n) (i32.const 0)))
    (local.set $u (select (i32.sub (i32.const 0) (local.get $n)) (local.get $n) (local.get $neg)))
    (loop $l
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.add (i32.const 48) (i32.rem_u (local.get $u) (i32.const 10))))
      (local.set $u (i32.div_u (local.get $u) (i32.const 10)))
      (br_if $l (local.get $u)))
    (if (local.get $neg) (then
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.const 45))))
    (call $write (local.get $p) (i32.sub (i32.const 48) (local.get $p))))
  ;; Prints a NUL-terminated string and a newline.
  (func $cstr (param $ptr i32)
    (local $end i32)
    (local.set $end (local.get $ptr))
    (block $done (loop $l
      (br_if $done (i32.eqz (i32.load8_u (local.get $end))))
      (local.set $end (i32.add (local.get $end) (i32.const 1)))
      (br $l)))
    (call $write (local.get $ptr) (i32.sub (local.get $end) (local.get $ptr)))
    (i32.store8 (i32.const 48) (i32.const 10))
    (call $write (i32.const 48) (i32.const 1)))
  ;; Prints `count` strings from a pointer table.
  (func $table (param $ptrs i32) (param $count i32)
    (local $i i32)
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (call $cstr (i32.load (i32.add (local.get $ptrs) (i32.mul (local.get $i) (i32.const 4)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l))))
  (func $init
    (global.set $r1 (call $fd_write (i32.const 1) (i32.const 0) (i32.const 0) (i32.const 8)))
    (global.set $r2 (call $args_sizes_get (i32.const 80) (i32.const 84)))
    (global.set $r3 (call $fd_close (i32.const 99)))
    (global.set $r4 (call $fd_prestat_get (i32.const 3) (i32.const 72)))
    (global.set $r5 (call $path_open (i32.const 99) (i32.const 2) (i32.const 0) (i32.const 0)
      (i32.const 0) (i64.const 0) (i64.const 0) (i32.const 0) (i32.const 64)))
    (global.set $r6 (call $random_get (i32.const 0) (i32.const 0)))
    (global.set $r7 (call $fd_read (i32.const 99) (i32.const 0) (i32.const 0) (i32.const 8)))
    (global.set $r8 (call $fd_close (i32.const 2))))
  (start $init)

  (func (export "_start")
    (call $num (global.get $r1))
    (call $num (global.get $r2))
    (call $num (global.get $r3))
    (call $num (global.get $r4))
    (call $num (global.get $r5))
    (call $num (global.get $r6))
    (call $num (global.get $r7))
    (call $num (global.get $r8))
    ;; now bound
    (call $num (call $fd_prestat_get (i32.const 3) (i32.const 72)))
  )
)
