;; fd_readdir: "." and "..", 24-byte dirents, cookies, truncation in small buffers.
;; Dumps "<errno> <used>" lines followed by the raw buffer bytes.
(module
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_readdir" (func $fd_readdir (param i32 i32 i32 i64 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_open" (func $path_open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 1024) "rd")
  (data (i32.const 1088) "rd/f1")

  (func $write (param $ptr i32) (param $len i32)
    (i32.store (i32.const 0) (local.get $ptr))
    (i32.store (i32.const 4) (local.get $len))
    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))
  (func $num (param $n i32)
    (local $p i32) (local $u i32) (local $neg i32)
    (i32.store8 (i32.const 47) (i32.const 10))
    (local.set $p (i32.const 47))
    (local.set $neg (i32.lt_s (local.get $n) (i32.const 0)))
    (local.set $u (select (i32.sub (i32.const 0) (local.get $n)) (local.get $n) (local.get $neg)))
    (loop $l
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.add (i32.const 48) (i32.rem_u (local.get $u) (i32.const 10))))
      (local.set $u (i32.div_u (local.get $u) (i32.const 10)))
      (br_if $l (local.get $u)))
    (if (local.get $neg) (then
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.const 45))))
    (call $write (local.get $p) (i32.sub (i32.const 48) (local.get $p))))
  ;; Prints a NUL-terminated string and a newline.
  (func $cstr (param $ptr i32)
    (local $end i32)
    (local.set $end (local.get $ptr))
    (block $done (loop $l
      (br_if $done (i32.eqz (i32.load8_u (local.get $end))))
      (local.set $end (i32.add (local.get $end) (i32.const 1)))
      (br $l)))
    (call $write (local.get $ptr) (i32.sub (local.get $end) (local.get $ptr)))
    (i32.store8 (i32.const 48) (i32.const 10))
    (call $write (i32.const 48) (i32.const 1)))
  ;; Prints `count` strings from a pointer table.
  (func $table (param $ptrs i32) (param $count i32)
    (local $i i32)
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (call $cstr (i32.load (i32.add (local.get $ptrs) (i32.mul (local.get $i) (i32.const 4)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l))))
  (func $rd (param $fd i32) (param $len i32) (param $cookie i64)
    (local $r i32)
    (memory.fill (i32.const 4096) (i32.const 0xee) (i32.const 512))
    (i32.store (i32.const 68) (i32.const -1))
    (local.set $r (call $fd_readdir (local.get $fd) (i32.const 4096) (local.get $len)
      (local.get $cookie) (i32.const 68)))
    (call $num (local.get $r))
    (call $num (i32.load (i32.const 68)))
    (if (i32.eqz (local.get $r)) (then
      (call $write (i32.const 4096) (i32.load (i32.const 68))))))

  (func (export "_start")
    (local $rd i32) (local $file i32)
    (drop (call $path_open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 2) (i32.const 2)
      (i64.const 0x3fffffff) (i64.const 0x3fffffff) (i32.const 0) (i32.const 64)))
    (local.set $rd (i32.load (i32.const 64)))
    (call $rd (local.get $rd) (i32.const 512) (i64.const 0))
    ;; one byte, exactly one header, header + 1, header + name of "."
    (call $rd (local.get $rd) (i32.const 1) (i64.const 0))
    (call $rd (local.get $rd) (i32.const 24) (i64.const 0))
    (call $rd (local.get $rd) (i32.const 25) (i64.const 0))
    (call $rd (local.get $rd) (i32.const 30) (i64.const 0))
    (call $rd (local.get $rd) (i32.const 0) (i64.const 0))
    ;; cookies
    (call $rd (local.get $rd) (i32.const 512) (i64.const 1))
    (call $rd (local.get $rd) (i32.const 512) (i64.const 2))
    (call $rd (local.get $rd) (i32.const 512) (i64.const 4))
    (call $rd (local.get $rd) (i32.const 512) (i64.const 5))
    (call $rd (local.get $rd) (i32.const 512) (i64.const 100))
    (call $rd (local.get $rd) (i32.const 512) (i64.const -1))
    ;; the preopen itself
    (call $rd (i32.const 3) (i32.const 0) (i64.const 0))
    ;; errors: rights, bad fd, file fd, buffer fault, used-pointer fault
    (call $rd (i32.const 0) (i32.const 512) (i64.const 0))
    (call $rd (i32.const 99) (i32.const 512) (i64.const 0))
    (drop (call $path_open (i32.const 3) (i32.const 1) (i32.const 1088) (i32.const 5) (i32.const 0)
      (i64.const 0x3fffffff) (i64.const 0) (i32.const 0) (i32.const 64)))
    (local.set $file (i32.load (i32.const 64)))
    (call $rd (local.get $file) (i32.const 512) (i64.const 0))
    (call $num (call $fd_readdir (local.get $rd) (i32.const 65530) (i32.const 64) (i64.const 0) (i32.const 68)))
    (call $num (call $fd_readdir (local.get $rd) (i32.const 4096) (i32.const 64) (i64.const 0) (i32.const 0xfffffff0)))
    ;; a directory without the readdir right
    (drop (call $path_open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 2) (i32.const 2)
      (i64.const 0) (i64.const 0) (i32.const 0) (i32.const 64)))
    (call $rd (i32.load (i32.const 64)) (i32.const 512) (i64.const 0))
  )
)
