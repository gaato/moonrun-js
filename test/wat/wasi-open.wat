;; path_open flag/rights validation, sandboxing, file I/O on opened fds, fd_close, prestat.
;; Expects the layout created by test/unit/wasi.test.ts.
(module
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $fd_read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close" (func $fd_close (param i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_prestat_get" (func $fd_prestat_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_prestat_dir_name" (func $fd_prestat_dir_name (param i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_open" (func $path_open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 1024) "data.txt")
  (data (i32.const 1088) "../outside.txt")
  (data (i32.const 1152) "link-in")
  (data (i32.const 1216) "link-out")
  (data (i32.const 1280) "dangling")
  (data (i32.const 1344) "sub")
  (data (i32.const 1408) "new.txt")
  (data (i32.const 1472) "nodir/x.txt")
  (data (i32.const 1536) "sub/../data.txt")
  (data (i32.const 1600) "/etc/passwd")
  (data (i32.const 1664) "link-dir")
  (data (i32.const 1728) "inner.txt")
  (data (i32.const 1792) "../data.txt")
  (data (i32.const 1856) "a\00b")
  (data (i32.const 1984) "missing.txt")
  (data (i32.const 2048) "data.txt/")
  (data (i32.const 2112) "abc")
  (data (i32.const 2176) "def")
  (data (i32.const 2240) "Z")

  (func $write (param $ptr i32) (param $len i32)
    (i32.store (i32.const 0) (local.get $ptr))
    (i32.store (i32.const 4) (local.get $len))
    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))
  (func $num (param $n i32)
    (local $p i32) (local $u i32) (local $neg i32)
    (i32.store8 (i32.const 47) (i32.const 10))
    (local.set $p (i32.const 47))
    (local.set $neg (i32.lt_s (local.get $n) (i32.const 0)))
    (local.set $u (select (i32.sub (i32.const 0) (local.get $n)) (local.get $n) (local.get $neg)))
    (loop $l
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.add (i32.const 48) (i32.rem_u (local.get $u) (i32.const 10))))
      (local.set $u (i32.div_u (local.get $u) (i32.const 10)))
      (br_if $l (local.get $u)))
    (if (local.get $neg) (then
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.const 45))))
    (call $write (local.get $p) (i32.sub (i32.const 48) (local.get $p))))
  ;; Prints a NUL-terminated string and a newline.
  (func $cstr (param $ptr i32)
    (local $end i32)
    (local.set $end (local.get $ptr))
    (block $done (loop $l
      (br_if $done (i32.eqz (i32.load8_u (local.get $end))))
      (local.set $end (i32.add (local.get $end) (i32.const 1)))
      (br $l)))
    (call $write (local.get $ptr) (i32.sub (local.get $end) (local.get $ptr)))
    (i32.store8 (i32.const 48) (i32.const 10))
    (call $write (i32.const 48) (i32.const 1)))
  ;; Prints `count` strings from a pointer table.
  (func $table (param $ptrs i32) (param $count i32)
    (local $i i32)
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (call $cstr (i32.load (i32.add (local.get $ptrs) (i32.mul (local.get $i) (i32.const 4)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l))))
  ;; Prints the errno and, on success, the new fd (left at 64).
  (func $open (param $dirfd i32) (param $dirflags i32) (param $path i32) (param $len i32)
      (param $oflags i32) (param $rights i64) (param $inh i64) (param $fdflags i32) (result i32)
    (local $r i32)
    (i32.store (i32.const 64) (i32.const -1))
    (local.set $r (call $path_open (local.get $dirfd) (local.get $dirflags) (local.get $path)
      (local.get $len) (local.get $oflags) (local.get $rights) (local.get $inh)
      (local.get $fdflags) (i32.const 64)))
    (call $num (local.get $r))
    (if (i32.eqz (local.get $r)) (then (call $num (i32.load (i32.const 64)))))
    (i32.load (i32.const 64)))
  (func $fwrite (param $fd i32) (param $ptr i32) (param $len i32)
    (i32.store (i32.const 128) (local.get $ptr))
    (i32.store (i32.const 132) (local.get $len))
    (i32.store (i32.const 68) (i32.const -1))
    (call $num (call $fd_write (local.get $fd) (i32.const 128) (i32.const 1) (i32.const 68)))
    (call $num (i32.load (i32.const 68))))
  ;; Reads up to 64 bytes and prints errno, count and the bytes.
  (func $fread (param $fd i32)
    (local $r i32)
    (i32.store (i32.const 136) (i32.const 4096))
    (i32.store (i32.const 140) (i32.const 64))
    (i32.store (i32.const 68) (i32.const 0))
    (local.set $r (call $fd_read (local.get $fd) (i32.const 136) (i32.const 1) (i32.const 68)))
    (call $num (local.get $r))
    (call $num (i32.load (i32.const 68)))
    (call $write (i32.const 4096) (i32.load (i32.const 68))))

  (func (export "_start")
    (local $fd i32) (local $sub i32)
    ;; flag validation comes before any descriptor lookup
    (drop (call $open (i32.const 3) (i32.const 2) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 16) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 32)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 2)))
    (drop (call $open (i32.const 99) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 4)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 0x40000000) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const -1) (i32.const 0)))
    (drop (call $open (i32.const 99) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 1) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 0) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1856) (i32.const 3) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 0xfffffff0) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    ;; plain read
    (local.set $fd (call $open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (call $fread (local.get $fd))
    (call $fread (local.get $fd))
    (call $fwrite (local.get $fd) (i32.const 2112) (i32.const 3))
    ;; sandbox
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1088) (i32.const 14) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1600) (i32.const 11) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1536) (i32.const 15) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 0) (i32.const 1152) (i32.const 7) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1152) (i32.const 7) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1216) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 0) (i32.const 1216) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1280) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1280) (i32.const 8) (i32.const 1) (i64.const 66) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1664) (i32.const 8) (i32.const 2) (i64.const 0) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 0) (i32.const 1664) (i32.const 8) (i32.const 2) (i64.const 0) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 2048) (i32.const 9) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    ;; create / exclusive / missing parent / missing file
    (local.set $fd (call $open (i32.const 3) (i32.const 1) (i32.const 1408) (i32.const 7) (i32.const 1) (i64.const 66) (i64.const 0) (i32.const 0)))
    (call $fwrite (local.get $fd) (i32.const 2112) (i32.const 3))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1408) (i32.const 7) (i32.const 5) (i64.const 66) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1472) (i32.const 11) (i32.const 1) (i64.const 66) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1984) (i32.const 11) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    ;; Rust OpenOptions: truncate without write access, and append with truncate, are EINVAL
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 8) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1408) (i32.const 7) (i32.const 8) (i64.const 64) (i64.const 0) (i32.const 1)))
    ;; append, then truncate
    (local.set $fd (call $open (i32.const 3) (i32.const 1) (i32.const 1408) (i32.const 7) (i32.const 0) (i64.const 64) (i64.const 0) (i32.const 1)))
    (call $fwrite (local.get $fd) (i32.const 2176) (i32.const 3))
    (local.set $fd (call $open (i32.const 3) (i32.const 1) (i32.const 1408) (i32.const 7) (i32.const 8) (i64.const 64) (i64.const 0) (i32.const 0)))
    (call $fwrite (local.get $fd) (i32.const 2240) (i32.const 1))
    ;; write-only fd cannot be read
    (call $fread (local.get $fd))
    ;; directories
    (local.set $sub (call $open (i32.const 3) (i32.const 1) (i32.const 1344) (i32.const 3) (i32.const 2) (i64.const 0x3fffffff) (i64.const 0x3fffffff) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 2) (i64.const 0) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1344) (i32.const 3) (i32.const 3) (i64.const 0) (i64.const 0) (i32.const 0)))
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1344) (i32.const 3) (i32.const 10) (i64.const 0) (i64.const 0) (i32.const 0)))
    (local.set $fd (call $open (local.get $sub) (i32.const 1) (i32.const 1728) (i32.const 9) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (call $fread (local.get $fd))
    (drop (call $open (local.get $sub) (i32.const 1) (i32.const 1792) (i32.const 11) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (call $fread (local.get $sub))
    (call $fwrite (local.get $sub) (i32.const 2112) (i32.const 3))
    ;; the empty path names the directory itself; opened as a file it reads EISDIR
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1920) (i32.const 0) (i32.const 2) (i64.const 0) (i64.const 0) (i32.const 0)))
    (local.set $fd (call $open (i32.const 3) (i32.const 1) (i32.const 1920) (i32.const 0) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (call $fread (local.get $fd))
    ;; a file fd with every right is still not a directory
    (local.set $fd (call $open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 0x3fffffff) (i64.const 0x3fffffff) (i32.const 0)))
    (drop (call $open (local.get $fd) (i32.const 1) (i32.const 1728) (i32.const 9) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    ;; inherited rights are capped by the parent
    (local.set $sub (call $open (i32.const 3) (i32.const 1) (i32.const 1344) (i32.const 3) (i32.const 2) (i64.const 0x3fffffff) (i64.const 0) (i32.const 0)))
    (drop (call $open (local.get $sub) (i32.const 1) (i32.const 1728) (i32.const 9) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    (drop (call $open (local.get $sub) (i32.const 1) (i32.const 1728) (i32.const 9) (i32.const 0) (i64.const 0) (i64.const 0) (i32.const 0)))
    ;; a fault on the result pointer still consumes a descriptor
    (call $num (call $path_open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0) (i32.const 0xfffffffe)))
    (local.set $fd (call $open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    ;; fd_close
    (call $num (call $fd_close (local.get $fd)))
    (call $num (call $fd_close (local.get $fd)))
    (call $num (call $fd_close (i32.const 4)))
    (call $num (call $fd_close (i32.const 3)))
    (call $num (call $fd_close (i32.const 2)))
    (call $num (call $fd_close (i32.const -5)))
    (call $num (call $fd_close (i32.const 1000)))
    (call $fread (i32.const 4))
    ;; fds are never reused
    (drop (call $open (i32.const 3) (i32.const 1) (i32.const 1024) (i32.const 8) (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0)))
    ;; prestat
    (i64.store (i32.const 72) (i64.const -1))
    (call $num (call $fd_prestat_get (i32.const 3) (i32.const 72)))
    (call $num (i32.load (i32.const 72)))
    (call $num (i32.load (i32.const 76)))
    (call $num (call $fd_prestat_get (local.get $sub) (i32.const 72)))
    (call $num (call $fd_prestat_get (i32.const 0) (i32.const 72)))
    (call $num (call $fd_prestat_get (i32.const 3) (i32.const 65532)))
    (i32.store (i32.const 80) (i32.const 0x2a2a2a2a))
    (call $num (call $fd_prestat_dir_name (i32.const 3) (i32.const 80) (i32.const 3)))
    (call $write (i32.const 80) (i32.const 4))
    (call $num (call $fd_prestat_dir_name (i32.const 3) (i32.const 80) (i32.const 0)))
    (call $num (call $fd_prestat_dir_name (local.get $sub) (i32.const 80) (i32.const 1)))
    (call $num (call $fd_prestat_dir_name (i32.const 3) (i32.const 65535) (i32.const 2)))
    (call $num (call $fd_prestat_dir_name (i32.const 3) (i32.const 65535) (i32.const 1)))
  )
)
