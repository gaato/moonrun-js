;; path_create_directory / path_remove_directory / path_unlink_file / path_rename / path_readlink.
;; Expects the layout created by test/unit/wasi.test.ts.
(module
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_create_directory" (func $mkdir (param i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_remove_directory" (func $rmdir (param i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_unlink_file" (func $unlink (param i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_rename" (func $rename (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_readlink" (func $readlink (param i32 i32 i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 1024) "newdir")
  (data (i32.const 1088) ".")
  (data (i32.const 1152) "..")
  (data (i32.const 1216) "../escape")
  (data (i32.const 1280) "a/b/c")
  (data (i32.const 1344) "full")
  (data (i32.const 1408) "data.txt")
  (data (i32.const 1472) "empty")
  (data (i32.const 1536) "renamed.txt")
  (data (i32.const 1600) "missing")
  (data (i32.const 1664) "link-in")
  (data (i32.const 1728) "link-out")
  (data (i32.const 1792) "sub/..")
  (data (i32.const 1856) "newdir/")
  (data (i32.const 1920) "/")
  (data (i32.const 1984) "sub/inner.txt")
  (data (i32.const 2048) "link-dir")
  (data (i32.const 2112) "../outside.txt")
  (data (i32.const 2176) "data.txt/x")
  (data (i32.const 2240) "dangling")
  (data (i32.const 2304) "inner-moved.txt")
  (data (i32.const 2368) "sub")
  (data (i32.const 2432) "\n")

  (func $write (param $ptr i32) (param $len i32)
    (i32.store (i32.const 0) (local.get $ptr))
    (i32.store (i32.const 4) (local.get $len))
    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))
  (func $num (param $n i32)
    (local $p i32) (local $u i32) (local $neg i32)
    (i32.store8 (i32.const 47) (i32.const 10))
    (local.set $p (i32.const 47))
    (local.set $neg (i32.lt_s (local.get $n) (i32.const 0)))
    (local.set $u (select (i32.sub (i32.const 0) (local.get $n)) (local.get $n) (local.get $neg)))
    (loop $l
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.add (i32.const 48) (i32.rem_u (local.get $u) (i32.const 10))))
      (local.set $u (i32.div_u (local.get $u) (i32.const 10)))
      (br_if $l (local.get $u)))
    (if (local.get $neg) (then
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.const 45))))
    (call $write (local.get $p) (i32.sub (i32.const 48) (local.get $p))))
  ;; Prints a NUL-terminated string and a newline.
  (func $cstr (param $ptr i32)
    (local $end i32)
    (local.set $end (local.get $ptr))
    (block $done (loop $l
      (br_if $done (i32.eqz (i32.load8_u (local.get $end))))
      (local.set $end (i32.add (local.get $end) (i32.const 1)))
      (br $l)))
    (call $write (local.get $ptr) (i32.sub (local.get $end) (local.get $ptr)))
    (i32.store8 (i32.const 48) (i32.const 10))
    (call $write (i32.const 48) (i32.const 1)))
  ;; Prints `count` strings from a pointer table.
  (func $table (param $ptrs i32) (param $count i32)
    (local $i i32)
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (call $cstr (i32.load (i32.add (local.get $ptrs) (i32.mul (local.get $i) (i32.const 4)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l))))
  (func $rl (param $dirfd i32) (param $path i32) (param $len i32) (param $buf i32) (param $buflen i32)
    (local $r i32)
    (i32.store (i32.const 68) (i32.const -1))
    (local.set $r (call $readlink (local.get $dirfd) (local.get $path) (local.get $len)
      (local.get $buf) (local.get $buflen) (i32.const 68)))
    (call $num (local.get $r))
    (if (i32.eqz (local.get $r)) (then
      (call $num (i32.load (i32.const 68)))
      (call $write (local.get $buf) (i32.load (i32.const 68)))
      (call $write (i32.const 2432) (i32.const 1)))))

  (func (export "_start")
    ;; create_directory
    (call $num (call $mkdir (i32.const 3) (i32.const 1024) (i32.const 6)))
    (call $num (call $mkdir (i32.const 3) (i32.const 1024) (i32.const 6)))
    (call $num (call $mkdir (i32.const 3) (i32.const 1024) (i32.const 0)))
    (call $num (call $mkdir (i32.const 3) (i32.const 1088) (i32.const 1)))
    (call $num (call $mkdir (i32.const 3) (i32.const 1152) (i32.const 2)))
    (call $num (call $mkdir (i32.const 3) (i32.const 1920) (i32.const 1)))
    (call $num (call $mkdir (i32.const 3) (i32.const 1792) (i32.const 6)))
    (call $num (call $mkdir (i32.const 3) (i32.const 1216) (i32.const 9)))
    (call $num (call $mkdir (i32.const 3) (i32.const 1280) (i32.const 5)))
    (call $num (call $mkdir (i32.const 1) (i32.const 1024) (i32.const 6)))
    (call $num (call $mkdir (i32.const 99) (i32.const 1024) (i32.const 6)))
    (call $num (call $mkdir (i32.const 3) (i32.const 0xfffffff0) (i32.const 6)))
    (call $num (call $mkdir (i32.const 3) (i32.const 1856) (i32.const 7)))
    (call $num (call $mkdir (i32.const 3) (i32.const 2176) (i32.const 10)))
    ;; remove_directory
    (call $num (call $rmdir (i32.const 3) (i32.const 1344) (i32.const 4)))
    (call $num (call $rmdir (i32.const 3) (i32.const 1408) (i32.const 8)))
    (call $num (call $rmdir (i32.const 3) (i32.const 1472) (i32.const 5)))
    (call $num (call $rmdir (i32.const 3) (i32.const 1472) (i32.const 5)))
    (call $num (call $rmdir (i32.const 3) (i32.const 1024) (i32.const 6)))
    (call $num (call $rmdir (i32.const 3) (i32.const 2048) (i32.const 8)))
    (call $num (call $rmdir (i32.const 3) (i32.const 1088) (i32.const 1)))
    (call $num (call $rmdir (i32.const 0) (i32.const 1344) (i32.const 4)))
    ;; unlink_file
    (call $num (call $unlink (i32.const 3) (i32.const 2368) (i32.const 3)))
    (call $num (call $unlink (i32.const 3) (i32.const 1600) (i32.const 7)))
    (call $num (call $unlink (i32.const 3) (i32.const 1728) (i32.const 8)))
    (call $num (call $unlink (i32.const 3) (i32.const 2112) (i32.const 14)))
    (call $num (call $unlink (i32.const 2) (i32.const 1600) (i32.const 7)))
    ;; rename
    (call $num (call $rename (i32.const 3) (i32.const 1408) (i32.const 8) (i32.const 3) (i32.const 1536) (i32.const 11)))
    (call $num (call $rename (i32.const 3) (i32.const 1600) (i32.const 7) (i32.const 3) (i32.const 1024) (i32.const 6)))
    (call $num (call $rename (i32.const 3) (i32.const 1536) (i32.const 11) (i32.const 3) (i32.const 1216) (i32.const 9)))
    (call $num (call $rename (i32.const 3) (i32.const 1536) (i32.const 11) (i32.const 3) (i32.const 1088) (i32.const 1)))
    (call $num (call $rename (i32.const 1) (i32.const 1536) (i32.const 11) (i32.const 3) (i32.const 1408) (i32.const 8)))
    (call $num (call $rename (i32.const 3) (i32.const 1536) (i32.const 11) (i32.const 0) (i32.const 1408) (i32.const 8)))
    (call $num (call $rename (i32.const 3) (i32.const 1536) (i32.const 11) (i32.const 3) (i32.const 1408) (i32.const 8)))
    (call $num (call $rename (i32.const 3) (i32.const 1344) (i32.const 4) (i32.const 3) (i32.const 2368) (i32.const 3)))
    (call $num (call $rename (i32.const 3) (i32.const 1984) (i32.const 13) (i32.const 3) (i32.const 2304) (i32.const 15)))
    (call $num (call $rename (i32.const 3) (i32.const 1408) (i32.const 8) (i32.const 3) (i32.const 0xfffffff0) (i32.const 4)))
    ;; readlink
    (call $rl (i32.const 3) (i32.const 1664) (i32.const 7) (i32.const 4096) (i32.const 64))
    (call $rl (i32.const 3) (i32.const 1664) (i32.const 7) (i32.const 4096) (i32.const 3))
    (call $rl (i32.const 3) (i32.const 2240) (i32.const 8) (i32.const 4096) (i32.const 64))
    (call $rl (i32.const 3) (i32.const 1408) (i32.const 8) (i32.const 4096) (i32.const 64))
    (call $rl (i32.const 3) (i32.const 1600) (i32.const 7) (i32.const 4096) (i32.const 64))
    (call $rl (i32.const 3) (i32.const 1664) (i32.const 7) (i32.const 65530) (i32.const 64))
    (call $rl (i32.const 3) (i32.const 1600) (i32.const 7) (i32.const 65530) (i32.const 64))
    (call $rl (i32.const 1) (i32.const 1664) (i32.const 7) (i32.const 4096) (i32.const 64))
    (call $rl (i32.const 3) (i32.const 2112) (i32.const 14) (i32.const 4096) (i32.const 64))
    (call $num (call $readlink (i32.const 3) (i32.const 1664) (i32.const 7) (i32.const 4096) (i32.const 64) (i32.const 0xfffffff0)))
  )
)
