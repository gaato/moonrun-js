      "wasm": "cli_args",
      "argv": ["<wasm>", "a", "--no-stack-trace", "b"],
      "divergences": ["D5"]
    },
    {
      "id": "argv/hyphen-arg-after-path",
      "area": "cli",
      "wasm": "cli_args",
      "argv": ["<wasm>", "-x", "foo"],
      "divergences": ["D5"]
    },
    {
      "id": "argv/unknown-long-after-path",
      "area": "cli",
      "wasm": "cli_args",
      "argv": ["<wasm>", "--foo", "bar"],
      "divergences": ["D5"]
    },
    {
      "id": "argv/unknown-long-before-path",
