{
  "$comment": "Upstream moon files compiled into the wasm components (docs/reuse.md). scripts/sync-upstream.ts extracts each `path` at the moon pin (scripts/upstream.ts) into crates/<crate>/upstream/<path>, applies `rewrites` (the only allowed edits) and checks the per-file hit counts, copies `stubs`, scans for OS calls the rewrites cannot reach, and aligns crates/Cargo.lock with moon's Cargo.lock. Counts cover the whole file, test modules included.",
  "rewrites": {
    "stdio-reexport": {
      "from": "pub\\(crate\\) use job::\\{Job, stdio_kind\\};",
      "to": "pub(crate) use job::{Job, WasiCheck, check_wasi};"
    },
    "std-os": {
      "from": "\\bstd::os::(unix|fd)::",
      "to": "crate::os::$1::"
    },
    "resolved-method": {
      "from": "\\bself\\.resolved\\(([a-z_]+)\\)\\.(is_file|is_dir|exists)\\(\\)",
      "to": "crate::os::path::$2(&self.resolved($1))"
    },
    "path-method": {
      "from": "\\bPath::new\\(([a-z_]+)\\)\\.(is_file|is_dir|exists)\\(\\)",
      "to": "crate::os::path::$2(Path::new($1))"
    },
    "std-fs": {
      "from": "\\bstd::fs::(read_to_string|canonicalize|read|metadata|symlink_metadata|read_link|read_dir|File|Metadata|write|create_dir_all|create_dir|remove_dir_all|remove_dir|remove_file|rename|OpenOptions|ReadDir)\\b",
      "to": "crate::os::fs::$1"
    },
    "std-env": {
      "from": "\\bstd::env::(vars_os|var_os|var|vars|current_dir)\\b",
      "to": "crate::os::env::$1"
    },
    "std-fs-io-module": {
      "from": "\\buse std::\\{fs, io\\};",
      "to": "use std::io;\nuse crate::os::fs;"
    },
    "serde-os-string-path": {
      "from": "\\bPath\\(OsString\\)",
      "to": "#[serde(with = \"crate::os_serde\")] Path(OsString)"
    },
    "serde-os-string-base": {
      "from": "\\bbase: OsString\\b",
      "to": "#[serde(with = \"crate::os_serde\")] base: OsString"
    }
  },
