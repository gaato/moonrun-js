(module
  (import "h" "wait" (func $wait (param i32) (result i32)))
  (import "h" "sync" (func $sync (param i32) (result i32)))
  (import "exception" "tag" (tag $t))
  (import "exception" "throw" (func $throw))
  (func $inner (export "inner") (param i32) (result i32)
    (drop (call $wait (local.get 0)))
    unreachable)
  (func $deep (param i32) (result i32)
    (if (result i32) (i32.eqz (local.get 0))
      (then (call $inner (i32.const 1)))
      (else (call $deep (i32.sub (local.get 0) (i32.const 1))))))
  (func (export "trap_after_resume") (result i32) (call $deep (i32.const 3)))
  (func (export "throw_after_resume") (drop (call $wait (i32.const 1))) (call $throw))
  (func (export "loop_sync") (param i32) (result i32) (local i32)
    (loop $l (local.set 1 (i32.add (local.get 1) (call $sync (local.get 0))))
      (local.set 0 (i32.sub (local.get 0) (i32.const 1)))
      (br_if $l (local.get 0))) (local.get 1))
  (func (export "loop_wait_nopromise") (param i32) (result i32) (local i32)
    (loop $l (local.set 1 (i32.add (local.get 1) (call $wait (i32.const 0))))
      (local.set 0 (i32.sub (local.get 0) (i32.const 1)))
      (br_if $l (local.get 0))) (local.get 1))
  (func $rec (export "rec") (param i32) (result i32)
    (if (result i32) (i32.eqz (local.get 0)) (then (i32.const 0))
      (else (i32.add (i32.const 1) (call $rec (i32.sub (local.get 0) (i32.const 1)))))))
  (func (export "rec_after_resume") (param i32) (result i32)
    (drop (call $wait (i32.const 1))) (call $rec (local.get 0)))
  (func (export "freeze") (result i32) (call $wait (i32.const 2)))
)
